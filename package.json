{
  "name": "hawapani",
  "version": "0.1.0",
  "private": true,
  "description": "A modern, responsive, and privacy-first weather Progressive Web Application (PWA) built with Next.js 16, React 19, TypeScript, and Tailwind CSS v4.",
  "author": "Rahul Raj Dahal",
  "license": "MIT",
  "homepage": "https://hawapani.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/rahulrajdahal/hawapani.git"
  },
  "bugs": {
    "url": "https://github.com/rahulrajdahal/hawapani/issues"
  },
  "keywords": [
    "hawapani",
    "weather",
    "nextjs",
    "react",
    "pwa",
    "forecast",
    "tailwindcss",
    "vitest",
    "cypress",
    "storybook"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint && tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cypress:open": "cypress open",
    "e2e": "start-server-and-test dev http://localhost:3000 \"cypress open --e2e\"",
    "e2e:headless": "start-server-and-test dev http://localhost:3000 \"cypress run --e2e\"",
    "component": "cypress open --component",
    "component:headless": "cypress run --component",
    "test": "npm run test:unit && npm run test:coverage && npm run component:headless && npm run e2e:headless"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@tailwindcss/postcss": "^4.3.3",
    "react": "^19",
    "react-dom": "^19",
    "react-hot-toast": "^2.6.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "cypress": "^16.1.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-storybook": "^10.6.0",
    "next": "^16.3.5",
    "postcss": "^8.5.28",
    "start-server-and-test": "^3.0.12",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
