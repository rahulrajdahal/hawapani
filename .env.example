# WeatherAPI Key (required for server-side weather fetching)
WEATHER_API_KEY=your_weatherapi_key_here

# Application Base URL (optional, defaults to https://hawapani.vercel.app)
NEXT_PUBLIC_APP_URL=https://hawapani.vercel.app

# PostHog Analytics (optional, privacy-respecting client analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
